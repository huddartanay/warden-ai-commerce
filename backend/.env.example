# Warden backend environment
# Copy to .env and fill in values

# PostgreSQL — the app expects a reachable Postgres.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://warden:warden@localhost:5432/warden

# CORS — comma-separated origins the frontend runs from
CORS_ORIGINS=http://localhost:3000

# Razorpay Test Mode — TEST KEYS ONLY. Warden refuses rzp_live_ keys.
# Leave blank to run in demo/mock mode (safe for offline hackathon demos).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay mode: auto | live | mock
#   auto — live if both RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are set, else mock
#   live — always call the real API; error if keys missing OR key is rzp_live_
#   mock — always use the deterministic mock (recommended for tests + demo)
RAZORPAY_MODE=auto

# LLM provider — Anthropic. If empty, Warden defaults to WARDEN_LLM_MODE=auto
# which picks the deterministic mock so the app works offline for demos.
ANTHROPIC_API_KEY=

# LLM mode: auto | live | mock
#   auto — live if ANTHROPIC_API_KEY is set, else mock (default)
#   live — always call the real API; error if key missing
#   mock — always use deterministic mock (recommended for tests + demo)
WARDEN_LLM_MODE=auto

# Anthropic model. Haiku 4.5 is fast, cheap, and enough for JSON extraction.
WARDEN_LLM_MODEL=claude-haiku-4-5-20251001

# Agent's own confidence threshold — below this the agent escalates the
# response to STEP_UP even if Warden would have ALLOWed.
AGENT_CONFIDENCE_THRESHOLD=0.7

# DEMO_MODE — set to "true" ONLY while presenting. Exposes /audit/demo/*
# routes that deliberately corrupt one audit row so the tamper detection
# can be shown live. MUST be off in any real deployment.
DEMO_MODE=false
