# Warden backend environment
# Copy to .env and fill in values

# PostgreSQL — the app expects a reachable Postgres.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://warden:warden@localhost:5432/warden

# CORS — comma-separated origins the frontend runs from
CORS_ORIGINS=http://localhost:3000

# Razorpay Test Mode (added in a later stage; keep placeholders here for now)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# LLM provider (added in a later stage)
ANTHROPIC_API_KEY=
